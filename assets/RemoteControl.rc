#include "RemoteControlBuildDate.h"
#include <windows.h>

1 ICON "RemoteControl.exe_14_MAINICON.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,REMOTE_CONTROL_BUILD_NUMBER
 PRODUCTVERSION 0,1,0,REMOTE_CONTROL_BUILD_NUMBER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Author", "Denveous\0"
            VALUE "Comments", "Developed by Denveous\0"
            VALUE "CompanyName", "Moreno Land\0"
            VALUE "FileDescription", "Remote Control\0"
            VALUE "FileVersion", REMOTE_CONTROL_BUILD_VERSION "\0"
            VALUE "InternalName", "RemoteControl\0"
            VALUE "LegalCopyright", "Copyright (C) " REMOTE_CONTROL_BUILD_YEAR " Moreno Land. All rights reserved.\0"
            VALUE "OriginalFilename", "RemoteControl.exe\0"
            VALUE "ProductName", "Remote Control\0"
            VALUE "ProductVersion", REMOTE_CONTROL_BUILD_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
