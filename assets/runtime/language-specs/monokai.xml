<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="monokai" _name="Monokai" version="1.0">
  <author>Remote Control</author>
  <_description>Monokai inspired editor colors</_description>
  <color name="background" value="#272822"/>
  <color name="foreground" value="#f8f8f2"/>
  <color name="line" value="#3e3d32"/>
  <color name="accent" value="#a6e22e"/>
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" background="#49483e" foreground="#ffffff"/>
  <style name="current-line" background="line"/>
  <style name="line-numbers" foreground="#75715e" background="line"/>
  <style name="def:comment" foreground="#75715e" italic="true"/>
  <style name="def:keyword" foreground="#f92672" bold="true"/>
  <style name="def:type" foreground="#66d9ef" italic="true"/>
  <style name="def:function" foreground="#a6e22e"/>
  <style name="def:string" foreground="#e6db74"/>
  <style name="def:constant" foreground="#ae81ff"/>
  <style name="def:number" foreground="#ae81ff"/>
  <style name="def:operator" foreground="#f92672"/>
  <style name="def:preprocessor" foreground="#a6e22e"/>
</style-scheme>
