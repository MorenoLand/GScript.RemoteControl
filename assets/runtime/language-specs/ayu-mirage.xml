<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="ayu-mirage" _name="Ayu Mirage" version="1.0">
  <author>Remote Control</author>
  <_description>Ayu Mirage inspired editor colors</_description>
  <color name="background" value="#1f2430"/>
  <color name="foreground" value="#cbccc6"/>
  <color name="line" value="#242936"/>
  <color name="accent" value="#ffcc66"/>
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" background="#3b4252" foreground="#ffffff"/>
  <style name="current-line" background="line"/>
  <style name="line-numbers" foreground="#707a8c" background="line"/>
  <style name="def:comment" foreground="#5c6773" italic="true"/>
  <style name="def:keyword" foreground="#ffad66" bold="true"/>
  <style name="def:type" foreground="#73d0ff"/>
  <style name="def:function" foreground="#ffd580"/>
  <style name="def:string" foreground="#d5ff80"/>
  <style name="def:constant" foreground="#dfbfff"/>
  <style name="def:number" foreground="#dfbfff"/>
  <style name="def:operator" foreground="#f29e74"/>
  <style name="def:preprocessor" foreground="#95e6cb"/>
</style-scheme>
