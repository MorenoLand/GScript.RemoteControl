<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="one-dark" _name="One Dark" version="1.0">
  <author>Remote Control</author>
  <_description>One Dark inspired editor colors</_description>
  <color name="background" value="#282c34"/>
  <color name="foreground" value="#abb2bf"/>
  <color name="line" value="#21252b"/>
  <color name="accent" value="#61afef"/>
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" background="#3e4451" foreground="#ffffff"/>
  <style name="current-line" background="line"/>
  <style name="line-numbers" foreground="#636d83" background="line"/>
  <style name="def:comment" foreground="#5c6370" italic="true"/>
  <style name="def:keyword" foreground="#c678dd" bold="true"/>
  <style name="def:type" foreground="#e5c07b"/>
  <style name="def:function" foreground="#61afef"/>
  <style name="def:string" foreground="#98c379"/>
  <style name="def:constant" foreground="#d19a66"/>
  <style name="def:number" foreground="#d19a66"/>
  <style name="def:operator" foreground="#56b6c2"/>
  <style name="def:preprocessor" foreground="#e06c75"/>
</style-scheme>
