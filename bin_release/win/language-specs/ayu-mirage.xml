<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="ayu-mirage" _name="Ayu Mirage" version="1.0">
  <author>Remote Control</author>
  <_description>Ayu Mirage inspired editor colors</_description>
  <color name="background" value="#242936"/>
  <color name="foreground" value="#cccac2"/>
  <color name="line" value="#1a1f29"/>
  <color name="accent" value="#ffcc66"/>
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" background="#3b4354" foreground="#ffffff"/>
  <style name="current-line" background="line"/>
  <style name="line-numbers" foreground="#8a9199" background="line"/>
  <style name="def:comment" foreground="#b8cfe6" italic="true"/>
  <style name="def:keyword" foreground="#ffad66" bold="true"/>
  <style name="def:type" foreground="#73d0ff"/>
  <style name="def:function" foreground="#ffd173"/>
  <style name="def:string" foreground="#d5ff80"/>
  <style name="def:constant" foreground="#dfbfff"/>
  <style name="def:number" foreground="#dfbfff"/>
  <style name="def:operator" foreground="#f29e74"/>
  <style name="def:preprocessor" foreground="#95e6cb"/>
  <style name="Comment" foreground="#b8cfe6"/>
  <style name="String" foreground="#d5ff80"/>
  <style name="Decimal" foreground="#dfbfff"/>
  <style name="Keyword" foreground="#ffad66" bold="true"/>
  <style name="Others" foreground="#95e6cb"/>
  <style name="Others 4" foreground="#ffcc66"/>
  <style name="Others 5" foreground="#95e6cb"/>
  <style name="Operators" foreground="#f29e74"/>
  <style name="Object Properties" foreground="#73d0ff"/>
  <style name="Function" foreground="#ffd173"/>
</style-scheme>
