<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="tokyo-night" _name="Tokyo Night" version="1.0">
  <author>Remote Control</author>
  <_description>Tokyo Night inspired editor colors</_description>
  <color name="background" value="#1a1b26"/><color name="foreground" value="#c0caf5"/><color name="line" value="#16161e"/>
  <style name="text" foreground="foreground" background="background"/><style name="selection" background="#33467c" foreground="#ffffff"/><style name="current-line" background="line"/><style name="line-numbers" foreground="#565f89" background="line"/>
  <style name="def:comment" foreground="#565f89" italic="true"/><style name="def:keyword" foreground="#bb9af7" bold="true"/><style name="def:type" foreground="#2ac3de"/><style name="def:function" foreground="#7aa2f7"/><style name="def:string" foreground="#9ece6a"/><style name="def:constant" foreground="#ff9e64"/><style name="def:number" foreground="#ff9e64"/><style name="def:operator" foreground="#89ddff"/><style name="def:preprocessor" foreground="#bb9af7"/>
  <style name="Comment" foreground="#565f89"/><style name="String" foreground="#9ece6a"/><style name="Decimal" foreground="#ff9e64"/><style name="Keyword" foreground="#bb9af7" bold="true"/><style name="Others" foreground="#2ac3de"/><style name="Others 4" foreground="#e0af68"/><style name="Others 5" foreground="#bb9af7"/><style name="Operators" foreground="#89ddff"/><style name="Object Properties" foreground="#73daca"/><style name="Function" foreground="#7aa2f7"/>
</style-scheme>
