<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="nord" _name="Nord" version="1.0">
  <author>Remote Control</author>
  <_description>Nord inspired editor colors</_description>
  <color name="background" value="#2e3440"/>
  <color name="foreground" value="#eceff4"/>
  <color name="line" value="#3b4252"/>
  <color name="accent" value="#88c0d0"/>
  <style name="text" foreground="foreground" background="background"/>
  <style name="selection" background="#4c566a" foreground="#ffffff"/>
  <style name="current-line" background="line"/>
  <style name="line-numbers" foreground="#81a1c1" background="line"/>
  <style name="def:comment" foreground="#616e88" italic="true"/>
  <style name="def:keyword" foreground="#81a1c1" bold="true"/>
  <style name="def:type" foreground="#8fbcbb"/>
  <style name="def:function" foreground="#88c0d0"/>
  <style name="def:string" foreground="#a3be8c"/>
  <style name="def:constant" foreground="#b48ead"/>
  <style name="def:number" foreground="#b48ead"/>
  <style name="def:operator" foreground="#81a1c1"/>
  <style name="def:preprocessor" foreground="#5e81ac"/>
  <style name="Comment" foreground="#616e88" italic="true"/>
  <style name="String" foreground="#a3be8c"/>
  <style name="Decimal" foreground="#b48ead"/>
  <style name="Keyword" foreground="#81a1c1" bold="true"/>
  <style name="Others" foreground="#5e81ac"/>
  <style name="Others 4" foreground="#eceff4"/>
  <style name="Others 5" foreground="#88c0d0"/>
  <style name="Operators" foreground="#81a1c1"/>
  <style name="Object Properties" foreground="#8fbcbb"/>
  <style name="Function" foreground="#88c0d0"/>
</style-scheme>
